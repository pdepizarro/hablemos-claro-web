# Servicio de envío de correo (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Correo destino de los mensajes del formulario de contacto
CONTACT_EMAIL_TO=contacto@hablemosclaro.es

# Correo remitente (debe estar verificado en Resend)
RESEND_FROM_EMAIL=noreply@hablemosclaro.es

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://hablemosclaro.es
